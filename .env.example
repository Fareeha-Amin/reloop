# Copy to .env and fill in. Every variable here is read by backend/app/config.py.
# A variable is added to this file only when code starts reading it.

# SQLAlchemy URL using the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://reloop:CHANGE_ME@localhost:5432/reloop

# JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Separate database for pytest. Must NOT be the DATABASE_URL database: the test setup
# drops every table in it. If unset, database tests are skipped (shown in the summary).
TEST_DATABASE_URL=postgresql+psycopg://reloop:CHANGE_ME@localhost:5432/reloop_test
